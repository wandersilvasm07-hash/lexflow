# -----------------------------------------------------------------------------
# Patrono — variáveis de ambiente
# Copie para .env.local (desenvolvimento). Em produção, configure no fornecedor
# de alojamento (ex.: Vercel). NUNCA faça commit de segredos.
# -----------------------------------------------------------------------------

# URL pública da aplicação (links de convites e emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project Settings > API (valores públicos por natureza; o RLS protege os dados)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---- Fases seguintes (ainda não usadas) ------------------------------------
# SUPABASE_SECRET_KEY=            # só no servidor; tarefas administrativas (Fase 2+)
# WHATSAPP_ACCESS_TOKEN=          # Fase 2 — WhatsApp Business Platform
# WHATSAPP_APP_SECRET=            # Fase 2 — validação da assinatura dos webhooks
# WHATSAPP_VERIFY_TOKEN=          # Fase 2
# ANTHROPIC_API_KEY=              # Fase 2/3 — agente de IA e RAG
# META_ADS_ACCESS_TOKEN=          # Fase 5
# STRIPE_SECRET_KEY=              # Fase 6
# STRIPE_WEBHOOK_SECRET=          # Fase 6

# Testes de base de dados (Postgres local com o shim do Supabase)
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54322/lexflow_test
